#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
if [[ -L "${SCRIPT_PATH}" ]]; then
  LINK_TARGET="$(readlink "${SCRIPT_PATH}")"
  if [[ "${LINK_TARGET}" = /* ]]; then
    SCRIPT_PATH="${LINK_TARGET}"
  else
    SCRIPT_PATH="$(dirname "${SCRIPT_PATH}")/${LINK_TARGET}"
  fi
fi
SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"

export PIDOCKER_CONFIG_DIR="${PIDOCKER_TEST_CONFIG_DIR:-${XDG_CONFIG_HOME:-${HOME}/.config}/pidocker-test}"
export PIDOCKER_VOLUME_PREFIX="${PIDOCKER_VOLUME_PREFIX:-pidocker-test}"
export PIDOCKER_IMAGE="${PIDOCKER_IMAGE:-pidocker:test}"

exec "${SCRIPT_DIR}/pidocker" "$@"
