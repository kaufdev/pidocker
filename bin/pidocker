#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
PIDOCKER_IMAGE="${PIDOCKER_IMAGE:-pidocker:local}"
PIDOCKER_DOCKER_CONTEXT="${PIDOCKER_DOCKER_CONTEXT:-${REPO_ROOT}}"
PIDOCKER_DOCKERFILE="${PIDOCKER_DOCKERFILE:-${PIDOCKER_DOCKER_CONTEXT}/docker/Dockerfile}"
PIDOCKER_VOLUME_PREFIX="${PIDOCKER_VOLUME_PREFIX:-pidocker}"
PIDOCKER_HOME_VOLUME="${PIDOCKER_VOLUME_PREFIX}-home"
PIDOCKER_WORKSPACE_VOLUME="${PIDOCKER_VOLUME_PREFIX}-workspace"
PIDOCKER_CONFIG_DIR="${PIDOCKER_CONFIG_DIR:-${XDG_CONFIG_HOME:-${HOME}/.config}/pidocker}"
PIDOCKER_REPOS_DIR="${PIDOCKER_REPOS_DIR:-${PIDOCKER_CONFIG_DIR}/repos}"
PIDOCKER_PACKAGES_FILE="${PIDOCKER_PACKAGES_FILE:-${PIDOCKER_CONFIG_DIR}/packages.json}"
PIDOCKER_TOOLS_FILE="${PIDOCKER_TOOLS_FILE:-${PIDOCKER_CONFIG_DIR}/tools.json}"
PIDOCKER_TOOLS_IMAGE="${PIDOCKER_TOOLS_IMAGE:-${PIDOCKER_IMAGE}-tools}"
PIDOCKER_TOOLS_LABEL="org.pidocker.tools.sha"
PIDOCKER_HOST_AGENTS_DIR="${PIDOCKER_HOST_AGENTS_DIR:-${HOME}/.pi/agent/agents}"
PIDOCKER_HOST_SKILLS_DIR="${PIDOCKER_HOST_SKILLS_DIR:-${HOME}/.pi/agent/skills}"

show_help() {
  cat <<'HELP'
pidocker - run Pi inside a Docker container

Usage:
  pidocker [--help]
  pidocker [REPO|GIT_URL]
  pidocker setupssh
  pidocker secrets set KEY
  pidocker packages add PACKAGE
  pidocker packages remove PACKAGE
  pidocker packages list
  pidocker tools add apt:PACKAGE
  pidocker tools remove apt:PACKAGE
  pidocker tools list
  pidocker tools build
  pidocker agents sync [--delete]
  pidocker agents list
  pidocker skills sync [--delete]
  pidocker skills list
  pidocker completion bash|zsh
  pidocker repos add ALIAS GIT_URL
  pidocker repos list
  pidocker repos remove ALIAS

Commands:
  setupssh                 Create/show the dedicated pidocker SSH public key
  secrets set KEY          Read a secret value securely and store it in pidocker-home
  packages add PACKAGE     Persist a pinned Pi package in host config
  packages remove PACKAGE  Remove a package from host config
  packages list            List packages from host config
  tools add apt:PACKAGE    Persist an apt system tool in host config
  tools remove apt:PACKAGE Remove a system tool from host config
  tools list               List system tools from host config
  tools build              Build the configured tools image now
  agents sync [--delete]   Sync host Pi agents into pidocker-home
  agents list              List host and pidocker global agents
  skills sync [--delete]   Sync host Pi skills into pidocker-home
  skills list              List host and pidocker global skills
  completion bash|zsh      Print shell completion for repository names
  repos add ALIAS GIT_URL  Configure a repository alias
  repos list               List repository aliases
  repos remove ALIAS       Remove a repository alias

Arguments:
  REPO      Start Pi in /workspace/repos/REPO
  GIT_URL   Clone the repository into /workspace/repos, then start Pi there

Options:
  -h, --help    Show this help message and exit
HELP
}

ensure_docker_available() {
  if ! command -v docker >/dev/null 2>&1; then
    echo "pidocker: docker command not found" >&2
    exit 127
  fi
}

ensure_image_exists() {
  if docker image inspect "${PIDOCKER_IMAGE}" >/dev/null 2>&1; then
    return 0
  fi

  docker build --file "${PIDOCKER_DOCKERFILE}" -t "${PIDOCKER_IMAGE}" "${PIDOCKER_DOCKER_CONTEXT}"
}

validate_repo_alias() {
  local alias="${1:-}"
  if [[ ! "${alias}" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,39}$ ]]; then
    echo "pidocker: alias must match [A-Za-z0-9][A-Za-z0-9_-]{0,39}" >&2
    return 2
  fi
  case "${alias}" in
    setupssh|secrets|packages|tools|agents|skills|completion|repos)
      echo "pidocker: alias is reserved: ${alias}" >&2
      return 2
      ;;
  esac
}

validate_git_url() {
  local url="${1:-}"
  if [[ -z "${url}" || "${url}" == *[[:space:]]* ]]; then
    echo "pidocker: Git URL must be one non-empty line without whitespace" >&2
    return 2
  fi
  case "${url}" in
    https://*|http://*|ssh://*|git://*|git@*:*) ;;
    *)
      echo "pidocker: unsupported Git URL" >&2
      return 2
      ;;
  esac
}

repo_alias_path() {
  printf '%s/%s\n' "${PIDOCKER_REPOS_DIR}" "${1}"
}

repos_add() {
  local alias="${1:-}" url="${2:-}" tmp_file
  if [[ $# -ne 2 ]]; then
    echo "Usage: pidocker repos add ALIAS GIT_URL" >&2
    exit 2
  fi
  validate_repo_alias "${alias}"
  validate_git_url "${url}"
  mkdir -p "${PIDOCKER_REPOS_DIR}"
  umask 077
  tmp_file="$(mktemp "${PIDOCKER_REPOS_DIR}/.alias.XXXXXX")"
  printf '%s\n' "${url}" > "${tmp_file}"
  mv -f "${tmp_file}" "$(repo_alias_path "${alias}")"
  echo "Configured repository alias ${alias}."
}

repos_list() {
  local file found=0
  if [[ -d "${PIDOCKER_REPOS_DIR}" ]]; then
    while IFS= read -r -d '' file; do
      printf '%s\n' "$(basename "${file}")"
      found=1
    done < <(find "${PIDOCKER_REPOS_DIR}" -mindepth 1 -maxdepth 1 -type f ! -name '.alias.*' -print0 | sort -z)
  fi
  if [[ "${found}" -eq 0 ]]; then
    echo "No repository aliases configured."
  fi
}

repos_remove() {
  local alias="${1:-}" path
  if [[ $# -ne 1 ]]; then
    echo "Usage: pidocker repos remove ALIAS" >&2
    exit 2
  fi
  validate_repo_alias "${alias}"
  path="$(repo_alias_path "${alias}")"
  if [[ -f "${path}" ]]; then
    rm -f "${path}"
    echo "Removed repository alias ${alias}."
  else
    echo "Repository alias ${alias} was not configured."
  fi
}

repo_alias_url() {
  local alias="${1}" path="$(repo_alias_path "${1}")" url
  [[ -f "${path}" ]] || return 1
  IFS= read -r url < "${path}" || true
  validate_git_url "${url}" >/dev/null 2>&1 || return 2
  printf '%s\n' "${url}"
}

validate_package_spec() {
  local spec="${1:-}"
  local source ref remote

  if [[ -z "${spec}" || "${spec}" == *[[:space:]]* || "${spec}" == *\"* || "${spec}" == *\\* ]]; then
    echo "pidocker: package must be a single npm: or git: spec without spaces, quotes, or backslashes" >&2
    return 2
  fi

  case "${spec}" in
    npm:*)
      if [[ ! "${spec}" =~ ^npm:(@[A-Za-z0-9._-]+/[A-Za-z0-9._-]+|[A-Za-z0-9._-]+)@[0-9][A-Za-z0-9._+-]*$ ]]; then
        echo "pidocker: npm packages must be pinned, e.g. npm:@scope/name@1.2.3" >&2
        return 2
      fi
      ;;
    git:*)
      source="${spec#git:}"
      if [[ "${source}" != *@* ]]; then
        echo "pidocker: git packages must include a pinned ref, e.g. git:github.com/org/repo@v1.2.3" >&2
        return 2
      fi
      ref="${source##*@}"
      remote="${source%@*}"
      if [[ -z "${ref}" || -z "${remote}" ]]; then
        echo "pidocker: git packages must include a remote and pinned ref" >&2
        return 2
      fi
      case "${remote}" in
        https://*|http://*|ssh://*|git://*|github.com/*|git@*:*) ;;
        *)
          echo "pidocker: git packages must use a remote git URL, not a local path" >&2
          return 2
          ;;
      esac
      ;;
    *)
      echo "pidocker: package must start with npm: or git:" >&2
      return 2
      ;;
  esac
}

validate_package_remove_arg() {
  local spec="${1:-}"
  local source remote

  if validate_package_spec "${spec}" >/dev/null 2>&1; then
    return 0
  fi

  if [[ -z "${spec}" || "${spec}" == *[[:space:]]* || "${spec}" == *\"* || "${spec}" == *\\* ]]; then
    echo "pidocker: package must be a single npm: or git: spec without spaces, quotes, or backslashes" >&2
    return 2
  fi

  case "${spec}" in
    npm:@[A-Za-z0-9._-]*/[A-Za-z0-9._-]*|npm:[A-Za-z0-9._-]*)
      return 0
      ;;
    git:*)
      source="${spec#git:}"
      remote="${source%@*}"
      case "${remote}" in
        https://*|http://*|ssh://*|git://*|github.com/*|git@*:*) return 0 ;;
      esac
      ;;
  esac

  echo "pidocker: package to remove must be a valid npm: or git: package identity" >&2
  return 2
}

package_identity() {
  local spec="${1}"
  local rest
  case "${spec}" in
    npm:*)
      rest="${spec#npm:}"
      if [[ "${rest}" == @*/*@* || "${rest}" == [!@]*@* ]]; then
        printf '%s\n' "npm:${rest%@*}"
      else
        printf '%s\n' "npm:${rest}"
      fi
      ;;
    git:*)
      rest="${spec#git:}"
      printf '%s\n' "git:${rest%@*}"
      ;;
    *)
      printf '%s\n' "${spec}"
      ;;
  esac
}

read_host_packages() {
  if [[ ! -f "${PIDOCKER_PACKAGES_FILE}" ]]; then
    return 0
  fi

  awk '
    /"packages"[[:space:]]*:[[:space:]]*\[/ {
      if ($0 ~ /\[[[:space:]]*\]/) next
      in_packages = 1
      next
    }
    in_packages && /\]/ {
      in_packages = 0
      next
    }
    in_packages {
      line = $0
      sub(/^[[:space:]]*/, "", line)
      sub(/[[:space:]]*,?[[:space:]]*$/, "", line)
      if (line == "") next
      if (line !~ /^"[^"\\]*"$/) {
        print "pidocker: invalid packages config format: " FILENAME > "/dev/stderr"
        exit 2
      }
      sub(/^"/, "", line)
      sub(/"$/, "", line)
      print line
    }
  ' "${PIDOCKER_PACKAGES_FILE}"
}

read_validated_host_packages() {
  local spec tmp_file
  tmp_file="$(mktemp)"
  if ! read_host_packages > "${tmp_file}"; then
    rm -f "${tmp_file}"
    return 2
  fi
  while IFS= read -r spec; do
    [[ -z "${spec}" ]] && continue
    validate_package_spec "${spec}"
    printf '%s\n' "${spec}"
  done < "${tmp_file}"
  rm -f "${tmp_file}"
}

write_packages_from_file() {
  local source_file="${1}"
  local tmp_file packages_file_dir
  local first=1
  local spec
  packages_file_dir="$(dirname "${PIDOCKER_PACKAGES_FILE}")"
  mkdir -p "${packages_file_dir}"
  tmp_file="$(mktemp "${packages_file_dir}/packages.json.XXXXXX")"
  {
    printf '%s\n' '{'
    printf '%s\n' '  "packages": ['
    while IFS= read -r spec; do
      [[ -z "${spec}" ]] && continue
      if [[ "${first}" -eq 0 ]]; then
        printf '%s\n' ','
      fi
      printf '    "%s"' "${spec}"
      first=0
    done < "${source_file}"
    if [[ "${first}" -eq 0 ]]; then
      printf '%s\n' ''
    fi
    printf '%s\n' '  ]'
    printf '%s\n' '}'
  } > "${tmp_file}"
  mv "${tmp_file}" "${PIDOCKER_PACKAGES_FILE}"
}

host_package_specs_b64() {
  local packages
  packages="$(read_validated_host_packages)"
  printf '%s' "${packages}" | base64 | tr -d '\n'
}

packages_add() {
  local spec="${1:-}"
  local spec_identity existing existing_identity tmp_file existing_file
  if [[ -z "${spec}" || $# -ne 1 ]]; then
    echo "Usage: pidocker packages add PACKAGE" >&2
    exit 2
  fi
  validate_package_spec "${spec}"
  spec_identity="$(package_identity "${spec}")"
  tmp_file="$(mktemp)"
  existing_file="$(mktemp)"
  read_validated_host_packages > "${existing_file}"
  while IFS= read -r existing; do
    [[ -z "${existing}" ]] && continue
    existing_identity="$(package_identity "${existing}")"
    if [[ "${existing_identity}" != "${spec_identity}" ]]; then
      printf '%s\n' "${existing}" >> "${tmp_file}"
    fi
  done < "${existing_file}"
  printf '%s\n' "${spec}" >> "${tmp_file}"
  write_packages_from_file "${tmp_file}"
  rm -f "${tmp_file}" "${existing_file}"
  echo "Configured package ${spec} in ${PIDOCKER_PACKAGES_FILE}."
}

packages_remove() {
  local spec="${1:-}"
  local spec_identity existing existing_identity tmp_file existing_file removed=0
  if [[ -z "${spec}" || $# -ne 1 ]]; then
    echo "Usage: pidocker packages remove PACKAGE" >&2
    exit 2
  fi
  validate_package_remove_arg "${spec}"
  spec_identity="$(package_identity "${spec}")"
  tmp_file="$(mktemp)"
  existing_file="$(mktemp)"
  read_validated_host_packages > "${existing_file}"
  while IFS= read -r existing; do
    [[ -z "${existing}" ]] && continue
    existing_identity="$(package_identity "${existing}")"
    if [[ "${existing_identity}" = "${spec_identity}" ]]; then
      removed=1
    else
      printf '%s\n' "${existing}" >> "${tmp_file}"
    fi
  done < "${existing_file}"
  write_packages_from_file "${tmp_file}"
  rm -f "${tmp_file}" "${existing_file}"
  if [[ "${removed}" -eq 1 ]]; then
    echo "Removed package ${spec_identity} from ${PIDOCKER_PACKAGES_FILE}."
  else
    echo "Package ${spec_identity} was not configured."
  fi
}

packages_list() {
  local found=0
  local spec existing_file
  existing_file="$(mktemp)"
  read_validated_host_packages > "${existing_file}"
  while IFS= read -r spec; do
    [[ -z "${spec}" ]] && continue
    printf '%s\n' "${spec}"
    found=1
  done < "${existing_file}"
  rm -f "${existing_file}"
  if [[ "${found}" -eq 0 ]]; then
    echo "No host packages configured."
  fi
}

validate_tool_spec() {
  local spec="${1:-}"

  if [[ -z "${spec}" || "${spec}" == *[[:space:]]* || "${spec}" == *\"* || "${spec}" == *\\* ]]; then
    echo "pidocker: tool must be a single apt: spec without spaces, quotes, or backslashes" >&2
    return 2
  fi

  case "${spec}" in
    apt:*)
      if [[ ! "${spec}" =~ ^apt:[a-z0-9][a-z0-9.+-]*$ ]]; then
        echo "pidocker: apt tools must look like apt:binutils" >&2
        return 2
      fi
      ;;
    *)
      echo "pidocker: tool must start with apt:" >&2
      return 2
      ;;
  esac
}

read_host_tools() {
  if [[ ! -f "${PIDOCKER_TOOLS_FILE}" ]]; then
    return 0
  fi

  awk '
    /"tools"[[:space:]]*:[[:space:]]*\[/ {
      if ($0 ~ /\[[[:space:]]*\]/) next
      in_tools = 1
      next
    }
    in_tools && /\]/ {
      in_tools = 0
      next
    }
    in_tools {
      line = $0
      sub(/^[[:space:]]*/, "", line)
      sub(/[[:space:]]*,?[[:space:]]*$/, "", line)
      if (line == "") next
      if (line !~ /^"[^"\\]*"$/) {
        print "pidocker: invalid tools config format: " FILENAME > "/dev/stderr"
        exit 2
      }
      sub(/^"/, "", line)
      sub(/"$/, "", line)
      print line
    }
  ' "${PIDOCKER_TOOLS_FILE}"
}

read_validated_host_tools() {
  local spec tmp_file
  tmp_file="$(mktemp)"
  if ! read_host_tools > "${tmp_file}"; then
    rm -f "${tmp_file}"
    return 2
  fi
  while IFS= read -r spec; do
    [[ -z "${spec}" ]] && continue
    validate_tool_spec "${spec}"
    printf '%s\n' "${spec}"
  done < "${tmp_file}"
  rm -f "${tmp_file}"
}

write_tools_from_file() {
  local source_file="${1}"
  local tmp_file tools_file_dir
  local first=1
  local spec
  tools_file_dir="$(dirname "${PIDOCKER_TOOLS_FILE}")"
  mkdir -p "${tools_file_dir}"
  tmp_file="$(mktemp "${tools_file_dir}/tools.json.XXXXXX")"
  {
    printf '%s\n' '{'
    printf '%s\n' '  "tools": ['
    while IFS= read -r spec; do
      [[ -z "${spec}" ]] && continue
      if [[ "${first}" -eq 0 ]]; then
        printf '%s\n' ','
      fi
      printf '    "%s"' "${spec}"
      first=0
    done < "${source_file}"
    if [[ "${first}" -eq 0 ]]; then
      printf '%s\n' ''
    fi
    printf '%s\n' '  ]'
    printf '%s\n' '}'
  } > "${tmp_file}"
  mv "${tmp_file}" "${PIDOCKER_TOOLS_FILE}"
}

tools_add() {
  local spec="${1:-}"
  local existing tmp_file existing_file found=0
  if [[ -z "${spec}" || $# -ne 1 ]]; then
    echo "Usage: pidocker tools add apt:PACKAGE" >&2
    exit 2
  fi
  validate_tool_spec "${spec}"
  tmp_file="$(mktemp)"
  existing_file="$(mktemp)"
  read_validated_host_tools > "${existing_file}"
  while IFS= read -r existing; do
    [[ -z "${existing}" ]] && continue
    if [[ "${existing}" = "${spec}" ]]; then
      found=1
    fi
    printf '%s\n' "${existing}" >> "${tmp_file}"
  done < "${existing_file}"
  if [[ "${found}" -eq 0 ]]; then
    printf '%s\n' "${spec}" >> "${tmp_file}"
  fi
  write_tools_from_file "${tmp_file}"
  rm -f "${tmp_file}" "${existing_file}"
  echo "Configured tool ${spec} in ${PIDOCKER_TOOLS_FILE}. It will be installed into ${PIDOCKER_TOOLS_IMAGE} on the next pidocker run."
}

tools_remove() {
  local spec="${1:-}"
  local existing tmp_file existing_file removed=0
  if [[ -z "${spec}" || $# -ne 1 ]]; then
    echo "Usage: pidocker tools remove apt:PACKAGE" >&2
    exit 2
  fi
  validate_tool_spec "${spec}"
  tmp_file="$(mktemp)"
  existing_file="$(mktemp)"
  read_validated_host_tools > "${existing_file}"
  while IFS= read -r existing; do
    [[ -z "${existing}" ]] && continue
    if [[ "${existing}" = "${spec}" ]]; then
      removed=1
    else
      printf '%s\n' "${existing}" >> "${tmp_file}"
    fi
  done < "${existing_file}"
  write_tools_from_file "${tmp_file}"
  rm -f "${tmp_file}" "${existing_file}"
  if [[ "${removed}" -eq 1 ]]; then
    echo "Removed tool ${spec} from ${PIDOCKER_TOOLS_FILE}."
  else
    echo "Tool ${spec} was not configured."
  fi
}

tools_list() {
  local found=0
  local spec existing_file
  existing_file="$(mktemp)"
  read_validated_host_tools > "${existing_file}"
  while IFS= read -r spec; do
    [[ -z "${spec}" ]] && continue
    printf '%s\n' "${spec}"
    found=1
  done < "${existing_file}"
  rm -f "${existing_file}"
  if [[ "${found}" -eq 0 ]]; then
    echo "No host tools configured."
  fi
}

host_tools_configured() {
  local tmp_file result=1
  tmp_file="$(mktemp)"
  if ! read_validated_host_tools > "${tmp_file}"; then
    rm -f "${tmp_file}"
    return 2
  fi
  if [[ -s "${tmp_file}" ]]; then
    result=0
  fi
  rm -f "${tmp_file}"
  return "${result}"
}

tools_hash_from_file() {
  local source_file="${1}" base_image_id="${2}"
  if command -v shasum >/dev/null 2>&1; then
    { printf '%s\n' "${base_image_id}"; cat "${source_file}"; } | shasum -a 256 | awk '{print $1}'
  else
    { printf '%s\n' "${base_image_id}"; cat "${source_file}"; } | sha256sum | awk '{print $1}'
  fi
}

write_tools_dockerfile() {
  local source_file="${1}"
  local tools_hash="${2}"
  local spec package

  printf 'FROM %s\n\n' "${PIDOCKER_IMAGE}"
  printf 'LABEL %s="%s"\n\n' "${PIDOCKER_TOOLS_LABEL}" "${tools_hash}"
  printf '%s\n' 'USER root'
  printf '%s\n' 'RUN apt-get update \'
  printf '%s' '    && apt-get install -y --no-install-recommends'
  while IFS= read -r spec; do
    [[ -z "${spec}" ]] && continue
    package="${spec#apt:}"
    printf ' \\\n      %s' "${package}"
  done < "${source_file}"
  printf '%s\n' ' \'
  printf '%s\n' '    && apt-get clean \'
  printf '%s\n' '    && rm -rf /var/lib/apt/lists/*'
  printf '%s\n' 'USER pi'
}

ensure_user_tools_image() {
  local tools_file tools_hash current_hash inspect_format base_image_id
  tools_file="$(mktemp)"
  if ! read_validated_host_tools > "${tools_file}"; then
    rm -f "${tools_file}"
    return 2
  fi
  if [[ ! -s "${tools_file}" ]]; then
    rm -f "${tools_file}"
    ensure_image_exists
    return 0
  fi

  ensure_image_exists
  base_image_id="$(docker image inspect "${PIDOCKER_IMAGE}" --format '{{.Id}}')"
  tools_hash="$(tools_hash_from_file "${tools_file}" "${base_image_id}")"
  inspect_format="{{ index .Config.Labels \"${PIDOCKER_TOOLS_LABEL}\" }}"
  current_hash="$(docker image inspect "${PIDOCKER_TOOLS_IMAGE}" --format "${inspect_format}" 2>/dev/null || true)"
  if [[ "${current_hash}" = "${tools_hash}" ]]; then
    rm -f "${tools_file}"
    return 0
  fi

  echo "pidocker: building tools image ${PIDOCKER_TOOLS_IMAGE} from ${PIDOCKER_IMAGE}" >&2
  write_tools_dockerfile "${tools_file}" "${tools_hash}" | docker build -t "${PIDOCKER_TOOLS_IMAGE}" -
  rm -f "${tools_file}"
}

tools_build() {
  local tools_status
  if host_tools_configured; then
    ensure_docker_available
    ensure_user_tools_image
    echo "Built tools image ${PIDOCKER_TOOLS_IMAGE}."
    return 0
  fi
  tools_status=$?
  if [[ "${tools_status}" -eq 2 ]]; then
    return 2
  fi
  echo "No host tools configured."
}

list_host_agents() {
  if [[ ! -d "${PIDOCKER_HOST_AGENTS_DIR}" ]]; then
    return 0
  fi
  find "${PIDOCKER_HOST_AGENTS_DIR}" -maxdepth 1 -type f -name '*.md' -print 2>/dev/null \
    | sed 's#^.*/##' \
    | sort
}

agents_list() {
  ensure_docker_available
  ensure_image_exists

  echo "Host agents (${PIDOCKER_HOST_AGENTS_DIR}):"
  if ! list_host_agents | sed 's/^/  /'; then
    true
  fi

  echo "Pidocker agents (/home/pi/.pi/agent/agents):"
  docker run \
    --rm \
    --mount "type=volume,source=${PIDOCKER_HOME_VOLUME},target=/home/pi" \
    "${PIDOCKER_IMAGE}" \
    bash -lc 'find /home/pi/.pi/agent/agents -maxdepth 1 -type f -name "*.md" -printf "%f\n" 2>/dev/null | sort | sed "s/^/  /"'
}

agents_sync() {
  local delete_mode=0
  local tmp_dir synced_count=0
  if [[ "${1:-}" = "--delete" ]]; then
    delete_mode=1
    shift
  fi
  if [[ $# -ne 0 ]]; then
    echo "Usage: pidocker agents sync [--delete]" >&2
    exit 2
  fi

  ensure_docker_available
  ensure_image_exists

  tmp_dir="$(mktemp -d)"
  if [[ -d "${PIDOCKER_HOST_AGENTS_DIR}" ]]; then
    while IFS= read -r -d '' file; do
      cp "${file}" "${tmp_dir}/"
      synced_count=$((synced_count + 1))
    done < <(find "${PIDOCKER_HOST_AGENTS_DIR}" -maxdepth 1 -type f -name '*.md' -print0 2>/dev/null)
  fi

  COPYFILE_DISABLE=1 tar --no-xattrs -C "${tmp_dir}" -cf - . | docker run \
    --rm \
    -i \
    --user root \
    --env "PIDOCKER_AGENTS_DELETE=${delete_mode}" \
    --mount "type=volume,source=${PIDOCKER_HOME_VOLUME},target=/home/pi" \
    "${PIDOCKER_IMAGE}" \
    bash -lc '
      set -euo pipefail
      agents_dir=/home/pi/.pi/agent/agents
      mkdir -p "${agents_dir}"
      if [ "${PIDOCKER_AGENTS_DELETE:-0}" = "1" ]; then
        find "${agents_dir}" -maxdepth 1 -type f -name "*.md" -delete
      fi
      tar -C "${agents_dir}" -xf -
      chown -R pi:pi "${agents_dir}"
    '

  rm -rf "${tmp_dir}"
  echo "Synced ${synced_count} host agent(s) from ${PIDOCKER_HOST_AGENTS_DIR} to pidocker-home."
}

list_host_skills() {
  if [[ ! -d "${PIDOCKER_HOST_SKILLS_DIR}" ]]; then
    return 0
  fi
  {
    find "${PIDOCKER_HOST_SKILLS_DIR}" -maxdepth 1 -type f -name '*.md' -print 2>/dev/null
    find "${PIDOCKER_HOST_SKILLS_DIR}" -type f -name 'SKILL.md' -print 2>/dev/null
  } | sed "s#^${PIDOCKER_HOST_SKILLS_DIR%/}/##" | sort -u
}

skills_list() {
  ensure_docker_available
  ensure_image_exists

  echo "Host skills (${PIDOCKER_HOST_SKILLS_DIR}):"
  if ! list_host_skills | sed 's/^/  /'; then
    true
  fi

  echo "Pidocker skills (/home/pi/.pi/agent/skills):"
  docker run \
    --rm \
    --mount "type=volume,source=${PIDOCKER_HOME_VOLUME},target=/home/pi" \
    "${PIDOCKER_IMAGE}" \
    bash -lc '
      skills_dir=/home/pi/.pi/agent/skills
      if [ ! -d "${skills_dir}" ]; then exit 0; fi
      {
        find "${skills_dir}" -maxdepth 1 -type f -name "*.md" -print 2>/dev/null
        find "${skills_dir}" -type f -name "SKILL.md" -print 2>/dev/null
      } | sed "s#^${skills_dir%/}/##" | sort -u | sed "s/^/  /"
    '
}

skills_sync() {
  local delete_mode=0
  local tmp_dir synced_count=0
  if [[ "${1:-}" = "--delete" ]]; then
    delete_mode=1
    shift
  fi
  if [[ $# -ne 0 ]]; then
    echo "Usage: pidocker skills sync [--delete]" >&2
    exit 2
  fi

  ensure_docker_available
  ensure_image_exists

  tmp_dir="$(mktemp -d)"
  if [[ -d "${PIDOCKER_HOST_SKILLS_DIR}" ]]; then
    COPYFILE_DISABLE=1 tar --no-xattrs -C "${PIDOCKER_HOST_SKILLS_DIR}" -cf - . | tar -C "${tmp_dir}" -xf -
    synced_count="$(list_host_skills | sed '/^$/d' | wc -l | tr -d ' ')"
  fi

  COPYFILE_DISABLE=1 tar --no-xattrs -C "${tmp_dir}" -cf - . | docker run \
    --rm \
    -i \
    --user root \
    --env "PIDOCKER_SKILLS_DELETE=${delete_mode}" \
    --mount "type=volume,source=${PIDOCKER_HOME_VOLUME},target=/home/pi" \
    "${PIDOCKER_IMAGE}" \
    bash -lc '
      set -euo pipefail
      skills_dir=/home/pi/.pi/agent/skills
      mkdir -p "${skills_dir}"
      if [ "${PIDOCKER_SKILLS_DELETE:-0}" = "1" ]; then
        find "${skills_dir}" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
      fi
      tar -C "${skills_dir}" -xf -
      chown -R pi:pi "${skills_dir}"
    '

  rm -rf "${tmp_dir}"
  echo "Synced ${synced_count} host skill(s) from ${PIDOCKER_HOST_SKILLS_DIR} to pidocker-home."
}

run_container() {
  local repo_arg="${1:-}" instance_id="${2:-}" repo_alias="${3:-}" workspace_volume="${PIDOCKER_WORKSPACE_VOLUME}"
  if [[ -n "${instance_id}" ]]; then
    workspace_volume="${PIDOCKER_VOLUME_PREFIX}-${instance_id}-workspace"
    echo "pidocker: instance ${instance_id}"
    echo "pidocker: workspace volume ${workspace_volume}"
  fi

  ensure_docker_available

  local package_specs_b64 container_image tools_status
  package_specs_b64="$(host_package_specs_b64)"
  container_image="${PIDOCKER_IMAGE}"
  if host_tools_configured; then
    ensure_user_tools_image
    container_image="${PIDOCKER_TOOLS_IMAGE}"
  else
    tools_status=$?
    if [[ "${tools_status}" -eq 2 ]]; then
      exit 2
    fi
    ensure_image_exists
  fi

  local -a docker_args=(
    --rm -it
    --label app=pidocker
    --env "PIDOCKER_REPO_ARG=${repo_arg}"
    --env "PIDOCKER_PACKAGE_SPECS_B64=${package_specs_b64}"
    --mount "type=volume,source=${PIDOCKER_HOME_VOLUME},target=/home/pi"
  )
  local -a container_command=(bash -lc '
      set -euo pipefail
      settings_file=/home/pi/.pi/agent/settings.json
      keybindings_file=/home/pi/.pi/agent/keybindings.json
      mkdir -p /home/pi/.pi/agent
      PI_SETTINGS_FILE="${settings_file}" PI_KEYBINDINGS_FILE="${keybindings_file}" node <<"NODE"
const fs = require("fs");
const path = require("path");

function readJson(file) {
  try {
    const parsed = JSON.parse(fs.readFileSync(file, "utf8"));
    return parsed && typeof parsed === "object" && !Array.isArray(parsed) ? parsed : {};
  } catch (_) {
    return {};
  }
}

function writeJson(file, value) {
  fs.mkdirSync(path.dirname(file), { recursive: true });
  const content = `${JSON.stringify(value, null, 2)}\n`;
  try {
    if (fs.readFileSync(file, "utf8") === content) return;
  } catch (_) {}
  fs.writeFileSync(file, content);
}

const settingsFile = process.env.PI_SETTINGS_FILE;
const settings = readJson(settingsFile);
if (!Array.isArray(settings.packages)) settings.packages = [];
const hostPackages = Buffer.from(process.env.PIDOCKER_PACKAGE_SPECS_B64 || "", "base64")
  .toString("utf8")
  .split(/\n/)
  .filter(Boolean);
for (const pkg of ["npm:pi-web-access", "npm:@tifan/pi-fixed-editor", ...hostPackages]) {
  if (!settings.packages.includes(pkg)) {
    settings.packages.push(pkg);
  }
}
writeJson(settingsFile, settings);

const keybindingsFile = process.env.PI_KEYBINDINGS_FILE;
const keybindings = readJson(keybindingsFile);
const newLineAction = "tui.input.newLine";
const existingNewLine = keybindings[newLineAction] ?? keybindings.newLine;
const newLineKeys = Array.isArray(existingNewLine)
  ? existingNewLine.filter((key) => typeof key === "string")
  : typeof existingNewLine === "string"
    ? [existingNewLine]
    : ["shift+enter"];
for (const key of ["shift+enter", "ctrl+j"]) {
  if (!newLineKeys.includes(key)) {
    newLineKeys.push(key);
  }
}
keybindings[newLineAction] = newLineKeys;
delete keybindings.newLine;
writeJson(keybindingsFile, keybindings);
NODE

      secrets_file=/home/pi/.pidocker/secrets/env
      if [ -f "${secrets_file}" ]; then
        while IFS="=" read -r key value; do
          if [ -n "${key}" ] && [[ "${key}" =~ ^[A-Z_][A-Z0-9_]*$ ]]; then
            export "${key}=${value}"
          fi
        done < "${secrets_file}"
      fi
      repo_arg="${PIDOCKER_REPO_ARG:-}"
      workdir=/workspace/repos
      if [ -n "${repo_arg}" ]; then
        case "${repo_arg}" in
          *://*|git@*|ssh://*|*.git)
            repo_name="${repo_arg##*/}"
            repo_name="${repo_name%.git}"
            if [ -z "${repo_name}" ] || [ "${repo_name}" = ".." ] || [[ "${repo_name}" = */* ]]; then
              echo "pidocker: could not derive repository name from URL: ${repo_arg}" >&2
              exit 2
            fi
            workdir="/workspace/repos/${repo_name}"
            if [ ! -d "${workdir}/.git" ]; then
              mkdir -p /workspace/repos
              git clone "${repo_arg}" "${workdir}"
            fi
            ;;
          */*|.*|*..*)
            echo "pidocker: repository name must be a direct child of /workspace/repos" >&2
            exit 2
            ;;
          *)
            workdir="/workspace/repos/${repo_arg}"
            if [ ! -d "${workdir}" ]; then
              echo "pidocker: repository not found: ${workdir}" >&2
              echo "pidocker: available repositories:" >&2
              find /workspace/repos -mindepth 1 -maxdepth 1 -type d -printf "  %f\n" 2>/dev/null | sort >&2 || true
              exit 2
            fi
            ;;
        esac
      fi
      cd "${workdir}"
      pi_args=()
      if [ -n "${PIDOCKER_REPO_ALIAS:-}" ]; then
        pi_args+=( -e /usr/local/share/pidocker/pidocker-resume-repo.ts )
      fi
      if [ -n "${PIDOCKER_SESSION_PATH:-}" ]; then
        pi_args+=( --session "${PIDOCKER_SESSION_PATH}" )
      fi
      exec pi "${pi_args[@]}"
    ')

  if [[ -z "${repo_alias}" ]]; then
    docker_args+=(--mount "type=volume,source=${workspace_volume},target=/workspace")
    if [[ -n "${instance_id}" ]]; then
      docker_args+=(
        --env "PIDOCKER_INSTANCE_ID=${instance_id}"
        --env "PI_CODING_AGENT_SESSION_DIR=/home/pi/.pi/agent/instance-sessions/${instance_id}"
      )
    fi
    exec docker run "${docker_args[@]}" "${container_image}" "${container_command[@]}"
  fi

  local current_instance="${instance_id}" session_path=""
  local launch_id container_status request_status request_file
  local target_instance session_basename request_line line_count
  local -a launch_args
  while true; do
    workspace_volume="${PIDOCKER_VOLUME_PREFIX}-${current_instance}-workspace"
    launch_id="$(new_resume_launch_id)"
    launch_args=(
      "${docker_args[@]}"
      --name "${PIDOCKER_VOLUME_PREFIX}-${current_instance}"
      --env "PIDOCKER_INSTANCE_ID=${current_instance}"
      --env "PI_CODING_AGENT_SESSION_DIR=/home/pi/.pi/agent/instance-sessions/${current_instance}"
      --env "PIDOCKER_REPO_ALIAS=${repo_alias}"
      --env "PIDOCKER_RESUME_LAUNCH_ID=${launch_id}"
      --env "PIDOCKER_RESUME_REQUEST_DIR=/home/pi/.pidocker/resume-requests"
      --mount "type=volume,source=${workspace_volume},target=/workspace"
    )
    if [[ -n "${session_path}" ]]; then
      launch_args+=(--env "PIDOCKER_SESSION_PATH=${session_path}")
    fi

    if docker run "${launch_args[@]}" "${container_image}" "${container_command[@]}"; then
      container_status=0
    else
      container_status=$?
    fi

    request_file="$(mktemp)"
    if docker run \
      --rm \
      --env "PIDOCKER_RESUME_LAUNCH_ID=${launch_id}" \
      --mount "type=volume,source=${PIDOCKER_HOME_VOLUME},target=/home/pi" \
      "${container_image}" \
      bash -lc '
        request_file="/home/pi/.pidocker/resume-requests/${PIDOCKER_RESUME_LAUNCH_ID}.request"
        if [ -f "${request_file}" ]; then
          cat -- "${request_file}"
          rm -f -- "${request_file}"
        fi
      ' > "${request_file}"; then
      request_status=0
    else
      request_status=$?
    fi

    if [[ "${request_status}" -ne 0 ]]; then
      rm -f "${request_file}"
      echo "pidocker: could not inspect repository resume request" >&2
      return "${request_status}"
    fi
    if [[ ! -s "${request_file}" ]]; then
      rm -f "${request_file}"
      return "${container_status}"
    fi

    target_instance=""
    session_basename=""
    line_count=0
    request_line=""
    while IFS= read -r request_line || [[ -n "${request_line}" ]]; do
      line_count=$((line_count + 1))
      case "${line_count}" in
        1) target_instance="${request_line}" ;;
        2) session_basename="${request_line}" ;;
      esac
    done < "${request_file}"
    rm -f "${request_file}"

    if [[ "${line_count}" -ne 2 || ! "${target_instance}" =~ ^${repo_alias}-[0-9a-f]{12}$ || ! "${session_basename}" =~ ^[A-Za-z0-9._-]+\.jsonl$ ]]; then
      echo "pidocker: malformed repository resume request" >&2
      return 2
    fi

    workspace_volume="${PIDOCKER_VOLUME_PREFIX}-${target_instance}-workspace"
    if ! docker volume inspect "${workspace_volume}" >/dev/null 2>&1; then
      echo "pidocker: workspace volume not found: ${workspace_volume}" >&2
      return 1
    fi

    current_instance="${target_instance}"
    session_path="/home/pi/.pi/agent/instance-sessions/${current_instance}/${session_basename}"
    echo "pidocker: instance ${current_instance}"
    echo "pidocker: workspace volume ${PIDOCKER_VOLUME_PREFIX}-${current_instance}-workspace"
  done
}

setup_ssh() {
  ensure_docker_available
  ensure_image_exists

  exec docker run \
    --rm \
    --label app=pidocker \
    --mount "type=volume,source=${PIDOCKER_HOME_VOLUME},target=/home/pi" \
    --mount "type=volume,source=${PIDOCKER_WORKSPACE_VOLUME},target=/workspace" \
    "${PIDOCKER_IMAGE}" \
    pidocker-ssh-setup
}

new_instance_id() {
  printf '%s-%s\n' "${1}" "$(od -An -N6 -tx1 /dev/urandom | tr -d ' \n')"
}

new_resume_launch_id() {
  od -An -N16 -tx1 /dev/urandom | tr -d ' \n'
  printf '\n'
}

show_completion() {
  local shell="${1:-}"
  case "${shell}" in
    bash)
      cat <<'BASH'
_pidocker_complete() {
  local cur="${COMP_WORDS[COMP_CWORD]}"
  if [[ ${COMP_CWORD} -eq 1 ]]; then
    local commands="setupssh secrets packages tools agents skills completion repos --help -h"
    local repos aliases
    repos=$(docker run --rm --mount "type=volume,source=${PIDOCKER_VOLUME_PREFIX:-pidocker}-workspace,target=/workspace" "${PIDOCKER_IMAGE:-pidocker:local}" bash -lc 'find /workspace/repos -mindepth 1 -maxdepth 1 -type d -printf "%f\n" 2>/dev/null' 2>/dev/null || true)
    aliases=$(find "${PIDOCKER_REPOS_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/pidocker}/repos" -mindepth 1 -maxdepth 1 -type f -printf "%f\n" 2>/dev/null || true)
    COMPREPLY=( $(compgen -W "${commands} ${repos} ${aliases}" -- "${cur}") )
  fi
}
complete -F _pidocker_complete pidocker
BASH
      ;;
    zsh)
      cat <<'ZSH'
#compdef pidocker
_pidocker() {
  local -a repos aliases commands
  commands=(setupssh secrets packages tools agents skills completion repos --help -h)
  repos=(${(f)"$(docker run --rm --mount "type=volume,source=${PIDOCKER_VOLUME_PREFIX:-pidocker}-workspace,target=/workspace" "${PIDOCKER_IMAGE:-pidocker:local}" bash -lc 'find /workspace/repos -mindepth 1 -maxdepth 1 -type d -printf "%f\n" 2>/dev/null' 2>/dev/null)"})
  aliases=(${(f)"$(find "${PIDOCKER_REPOS_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/pidocker}/repos" -mindepth 1 -maxdepth 1 -type f -printf '%f\n' 2>/dev/null)"})
  _describe 'pidocker arguments' commands repos aliases
}
_pidocker "$@"
ZSH
      ;;
    *)
      echo "Usage: pidocker completion bash|zsh" >&2
      exit 2
      ;;
  esac
}

set_secret() {
  local key="${1:-}"
  if [[ -z "${key}" || $# -ne 1 ]]; then
    echo "Usage: pidocker secrets set KEY" >&2
    exit 2
  fi
  if [[ ! "${key}" =~ ^[A-Z_][A-Z0-9_]*$ ]]; then
    echo "pidocker: secret key must match [A-Z_][A-Z0-9_]*" >&2
    exit 2
  fi

  ensure_docker_available
  ensure_image_exists

  local value
  if [[ -t 0 ]]; then
    printf "Value for %s: " "${key}" >&2
    IFS= read -r -s value
    printf "\n" >&2
  else
    IFS= read -r value
  fi
  if [[ -z "${value}" ]]; then
    echo "pidocker: secret value must not be empty" >&2
    exit 2
  fi

  printf '%s' "${value}" | docker run \
    --rm \
    -i \
    --label app=pidocker \
    --env "PIDOCKER_SECRET_KEY=${key}" \
    --mount "type=volume,source=${PIDOCKER_HOME_VOLUME},target=/home/pi" \
    --mount "type=volume,source=${PIDOCKER_WORKSPACE_VOLUME},target=/workspace" \
    "${PIDOCKER_IMAGE}" \
    bash -lc '
      set -euo pipefail
      key="${PIDOCKER_SECRET_KEY}"
      value="$(cat)"
      umask 077
      mkdir -p /home/pi/.pidocker/secrets
      secrets_file=/home/pi/.pidocker/secrets/env
      tmp_file="$(mktemp)"
      if [ -f "${secrets_file}" ]; then
        grep -v -E "^${key}=" "${secrets_file}" > "${tmp_file}" || true
      fi
      printf "%s=%s\n" "${key}" "${value}" >> "${tmp_file}"
      mv "${tmp_file}" "${secrets_file}"
      chmod 600 "${secrets_file}"
      if [ "${key}" = "NOTION_API_KEY" ]; then
        printf "%s=%s\n" "${key}" "${value}" > /home/pi/.pidocker/secrets/notion.env
        chmod 600 /home/pi/.pidocker/secrets/notion.env
      fi
    '
  echo "Stored secret ${key} in pidocker-home."
}

case "${1:-}" in
  -h|--help)
    show_help
    exit 0
    ;;
  "")
    run_container
    ;;
  setupssh)
    setup_ssh
    ;;
  secrets)
    if [[ "${2:-}" != "set" || -z "${3:-}" || -n "${4:-}" ]]; then
      echo "Usage: pidocker secrets set KEY" >&2
      exit 2
    fi
    set_secret "${3}"
    ;;
  packages)
    case "${2:-}" in
      add)
        if [[ -z "${3:-}" || -n "${4:-}" ]]; then
          echo "Usage: pidocker packages add PACKAGE" >&2
          exit 2
        fi
        packages_add "${3}"
        ;;
      remove)
        if [[ -z "${3:-}" || -n "${4:-}" ]]; then
          echo "Usage: pidocker packages remove PACKAGE" >&2
          exit 2
        fi
        packages_remove "${3}"
        ;;
      list)
        if [[ -n "${3:-}" ]]; then
          echo "Usage: pidocker packages list" >&2
          exit 2
        fi
        packages_list
        ;;
      *)
        echo "Usage: pidocker packages add|remove|list [PACKAGE]" >&2
        exit 2
        ;;
    esac
    ;;
  tools)
    case "${2:-}" in
      add)
        if [[ -z "${3:-}" || -n "${4:-}" ]]; then
          echo "Usage: pidocker tools add apt:PACKAGE" >&2
          exit 2
        fi
        tools_add "${3}"
        ;;
      remove)
        if [[ -z "${3:-}" || -n "${4:-}" ]]; then
          echo "Usage: pidocker tools remove apt:PACKAGE" >&2
          exit 2
        fi
        tools_remove "${3}"
        ;;
      list)
        if [[ -n "${3:-}" ]]; then
          echo "Usage: pidocker tools list" >&2
          exit 2
        fi
        tools_list
        ;;
      build)
        if [[ -n "${3:-}" ]]; then
          echo "Usage: pidocker tools build" >&2
          exit 2
        fi
        tools_build
        ;;
      *)
        echo "Usage: pidocker tools add|remove|list|build [apt:PACKAGE]" >&2
        exit 2
        ;;
    esac
    ;;
  agents)
    case "${2:-}" in
      sync)
        if [[ -n "${4:-}" ]]; then
          echo "Usage: pidocker agents sync [--delete]" >&2
          exit 2
        fi
        if [[ -n "${3:-}" ]]; then
          agents_sync "${3}"
        else
          agents_sync
        fi
        ;;
      list)
        if [[ -n "${3:-}" ]]; then
          echo "Usage: pidocker agents list" >&2
          exit 2
        fi
        agents_list
        ;;
      *)
        echo "Usage: pidocker agents sync [--delete] | agents list" >&2
        exit 2
        ;;
    esac
    ;;
  skills)
    case "${2:-}" in
      sync)
        if [[ -n "${4:-}" ]]; then
          echo "Usage: pidocker skills sync [--delete]" >&2
          exit 2
        fi
        if [[ -n "${3:-}" ]]; then
          skills_sync "${3}"
        else
          skills_sync
        fi
        ;;
      list)
        if [[ -n "${3:-}" ]]; then
          echo "Usage: pidocker skills list" >&2
          exit 2
        fi
        skills_list
        ;;
      *)
        echo "Usage: pidocker skills sync [--delete] | skills list" >&2
        exit 2
        ;;
    esac
    ;;
  completion)
    if [[ -z "${2:-}" || -n "${3:-}" ]]; then
      echo "Usage: pidocker completion bash|zsh" >&2
      exit 2
    fi
    show_completion "${2}"
    ;;
  repos)
    case "${2:-}" in
      add)
        [[ -n "${3:-}" && -n "${4:-}" && -z "${5:-}" ]] || { echo "Usage: pidocker repos add ALIAS GIT_URL" >&2; exit 2; }
        repos_add "${3}" "${4}"
        ;;
      list)
        [[ -z "${3:-}" && -z "${4:-}" ]] || { echo "Usage: pidocker repos list" >&2; exit 2; }
        repos_list
        ;;
      remove)
        [[ -n "${3:-}" && -z "${4:-}" ]] || { echo "Usage: pidocker repos remove ALIAS" >&2; exit 2; }
        repos_remove "${3}"
        ;;
      *)
        echo "Usage: pidocker repos add ALIAS GIT_URL | repos list | repos remove ALIAS" >&2
        exit 2
        ;;
    esac
    ;;
  -* )
    echo "Unknown option: $1" >&2
    show_help >&2
    exit 2
    ;;
  *)
    if [[ -n "${2:-}" ]]; then
      echo "Usage: pidocker [REPO|GIT_URL]" >&2
      exit 2
    fi
    if validate_repo_alias "${1}" >/dev/null 2>&1; then
      if alias_url="$(repo_alias_url "${1}")"; then
        run_container "${alias_url}" "$(new_instance_id "${1}")" "${1}"
        exit 0
      fi
    fi
    run_container "${1}"
    ;;
esac
